<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotiq_hande">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import robotiq_hande urdf file -->
    <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="robotiq_hande.ros2_control.xacro" />

    <link name="world"/>

    <xacro:robotiq_hande_gripper parent="world" sim_gazebo="false">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:robotiq_hande_gripper>

    <xacro:robotiq_hande_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
