<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotiq_hande">
  <xacro:macro name="robotiq_hande_gripper" params="parent *origin">
  
    <!-- Adapter (base of the gripper) -->
    <joint name="adapter_joint" type="fixed">
       <xacro:insert_block name="origin" />
       <parent link="${parent}"/> 
       <child link="gripper_adapter"/>
    </joint>

    <link name="gripper_adapter">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/robotiq_adapter.stl"/>
        </geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/robotiq_adapter.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
      </inertial>
    </link>

    <ros2_control name="GripperHardware" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="finger_joint">
        <command_interface name="position" />
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort"/>
      </joint>
      <joint name="finger2_joint">
        <state_interface name="position" />
        <state_interface name="velocity" />
        <state_interface name="effort"/>
      </joint>
    </ros2_control>
  </xacro:macro>

  
  <!-- Gripper body -->
  <link name="gripper_body">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/Gripper_body.stl"/>
      </geometry>
      <material name="gray"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/Gripper_body.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="gripper_body_joint" type="fixed">
     <parent link="gripper_adapter"/>
     <child link="gripper_body"/>
     <origin xyz="0 0 0.01" rpy="0 0 0"/>
   </joint>

  <!-- Tool Center Point (TCP) -->
  <link name="tcp_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
  </link>
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_body"/>
    <child link="tcp_link"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/> 
  </joint>

  <!-- Fingers -->
  <link name="finger1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/finger1_v2.stl"/>
      </geometry>
      <material name="gray"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.01 -0.076 0.04" rpy="0 0 0"/> 
      <geometry>
        <box size="0.02 0.002 0.06" /> 
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="finger_joint" type="prismatic">
     <parent link="gripper_body"/>
     <child link="finger1"/>
     <origin xyz="-0.01443 0.011 0.0839" rpy="0 0 0"/>
     <axis xyz="0 1 0"/><limit lower="-0.003" upper="0.025" effort="500" velocity="0.1" acceleration="0.1"/> 
   </joint>

   <link name="finger2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/finger1_v2.stl"/>
      </geometry>
      <material name="gray"><color rgba="0.4 0.4 0.4 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0.01 -0.076 0.04" rpy="0 0 0"/> 
      <geometry>
        <box size="0.02 0.002 0.06" /> 
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="finger2_joint" type="prismatic">
     <parent link="gripper_body"/>
     <child link="finger2"/>
     <origin xyz="0.01443 -0.011 0.0839" rpy="0 0 ${pi}"/>
     <axis xyz="0 1 0"/><limit lower="-0.003" upper="0.025" effort="500" velocity="0.1" acceleration="0.1"/> 
     <mimic joint="finger_joint" multiplier="1.0" offset="0.0"/>
  </joint>



  <!-- Camera mount -->
  <link name="camera_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://closed_loop_dalsa_description/meshes/camera_mount_95.stl"/>
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://closed_loop_dalsa_description/meshes/camera_mount_95.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_mount_joint" type="fixed">
     <parent link="gripper_body"/>
     <child link="camera_mount"/>
     <origin xyz="-0.031 0 0.0755" rpy="0 ${-pi/2} 0"/>
   </joint>


  <!-- Camera -->
  <link name="camera_link">
    <visual>
      <geometry>
        <mesh filename="package://closed_loop_dalsa_description/meshes/realsense_D405.stl"/>
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://closed_loop_dalsa_description/meshes/realsense_D405.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <origin xyz="0.01 0 0.023" rpy="0 ${95*pi/180} 0"/>
  </joint>

  <link name="camera_link_optical"/>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy=" 0 ${-pi/2} 0"/>
  </joint>

  <gazebo reference="camera_link_optical">
    <sensor name="wrist_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image>
            <width>320</width>
            <height>240</height>
          </image>
          <clip><near>0.1</near><far>10</far></clip>
          <optical_frame_id>camera_link_optical</optical_frame_id>
        </camera>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <visualize>true</visualize>
        <topic>wrist_camera</topic>
    </sensor>
  </gazebo>
  
</robot>