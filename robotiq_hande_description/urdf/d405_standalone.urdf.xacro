<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="d405_camera">

  <link name="world"/>

  <!-- Camera Mount 95 -->
  <link name="camera_mount">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/camera_mount_95.stl"/>
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/camera_mount_95.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="world_to_camera_mount" type="fixed">
    <parent link="world"/>
    <child link="camera_mount"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <!-- RealSense D405 Body -->
  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/realsense_D405.stl"/>
      </geometry>
      <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/realsense_D405.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <origin xyz="0.01 0 0.023" rpy="0 ${5*pi/180} 0"/>
  </joint>

  <!-- Standard camera optical frame matching robotiq_hande_macro -->
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
  </joint>

  <!-- RealSense driver root frame alias -->
  <link name="wrist_camera_link"/>
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="wrist_camera_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

</robot>
