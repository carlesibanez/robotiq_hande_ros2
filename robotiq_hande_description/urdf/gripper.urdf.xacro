<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="robotiq_hande">

  <!-- Include the split macros -->
  <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande_macro.xacro" />
  <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande.ros2_control.xacro" />

  <link name="world"/>
  
  <!-- Configuration parameters -->
  <xacro:arg name="finger_type" default="aluminum" />
  <xacro:arg name="use_sim" default="true" />
  <xacro:arg name="use_camera" default="true" />
  <xacro:arg name="com_port" default="/tmp/ttyUR" />

  <!-- 1. Physical Geometry -->
  <xacro:robotiq_hande_gripper parent="world" finger_type="$(arg finger_type)" load_camera="$(arg use_camera)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_hande_gripper>

  <!-- 2. Control and Sensors (Passing sim_gz for Jazzy) -->
  <xacro:robotiq_hande_ros2_control
    sim_gz="$(arg use_sim)"
    use_mock_hardware="false"
    mock_gripper="false"
    load_camera="$(arg use_camera)"
    com_port="$(arg com_port)"/>

  <xacro:if value="$(arg use_sim)">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find robotiq_hande_control)/config/controllers.yaml</parameters>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>