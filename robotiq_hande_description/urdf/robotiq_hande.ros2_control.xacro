<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="robotiq_hande_ros2_control" params="sim_gz:=true use_mock_hardware:=false mock_gripper:=false com_port:=/tmp/ttyUR load_camera:=true">

    <xacro:if value="${sim_gz}">
      
      <!-- Gazebo Camera Sensor -->
      <xacro:if value="${load_camera}">
        <gazebo reference="camera_link">
          <sensor name="wrist_camera" type="rgbd_camera">
            <camera>
              <horizontal_fov>1.518436</horizontal_fov>
              <image>
                <width>1280</width>
                <height>720</height>
              </image>
              <clip>
                <near>0.05</near>
                <far>10</far>
              </clip>
              <optical_frame_id>camera_link</optical_frame_id>
            </camera>
            <always_on>1</always_on>
            <update_rate>15</update_rate>
            <visualize>true</visualize>
            <topic>wrist_camera</topic>
          </sensor>
        </gazebo>
      </xacro:if>

      <!-- Gazebo Motor Controller -->
      <ros2_control name="GripperHardware" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="finger_joint">
          <command_interface name="position" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort"/>
        </joint>
        <joint name="finger2_joint">
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort"/>
        </joint>
      </ros2_control>

      

    </xacro:if>

    <xacro:unless value="${sim_gz}">
      <!-- Check if either full mock hardware or gripper mock hardware is requested -->
      <xacro:if value="${use_mock_hardware or mock_gripper}">
        <ros2_control name="GripperHardware" type="system">
          <hardware>
            <plugin>mock_components/GenericSystem</plugin>
          </hardware>
          <joint name="finger_joint">
            <command_interface name="position" />
            <state_interface name="position">
              <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
          </joint>
          <joint name="finger2_joint">
            <param name="mimic">finger_joint</param>
            <param name="multiplier">1</param>
            <state_interface name="position" />
            <state_interface name="velocity" />
          </joint>
        </ros2_control>
      </xacro:if>

      <xacro:unless value="${use_mock_hardware or mock_gripper}">
        <!-- Real Robotiq Gripper Driver Interface -->
        <ros2_control name="GripperHardware" type="system">
          <hardware>
            <plugin>robotiq_driver/RobotiqGripperHardwareInterface</plugin>
            <param name="gripper_profile">hand_e</param>
            <param name="gripper_closed_position">0.025</param>
            <param name="COM_port">${com_port}</param>
            <param name="baudrate">115200</param>
            <param name="slave_address">9</param>
          </hardware>
          <joint name="finger_joint">
            <command_interface name="position" />
            <state_interface name="position">
              <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
          </joint>
        </ros2_control>
      </xacro:unless>
    </xacro:unless>

  </xacro:macro>
</robot>