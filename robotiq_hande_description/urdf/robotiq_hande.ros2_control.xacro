<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="robotiq_hande_ros2_control" params="sim_gz:=true">

    <xacro:if value="${sim_gz}">
      
      <!-- Gazebo Camera Sensor -->
      <gazebo reference="camera_link">
        <sensor name="wrist_camera" type="rgbd_camera">
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>320</width>
              <height>240</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>10</far>
            </clip>
            <optical_frame_id>camera_link</optical_frame_id>
          </camera>
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <visualize>true</visualize>
          <topic>wrist_camera</topic>
        </sensor>
      </gazebo>

      <!-- Gazebo Motor Controller -->
      <ros2_control name="GripperHardware" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>
        <joint name="finger_joint">
          <command_interface name="position" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort"/>
        </joint>
        <joint name="finger2_joint">
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort"/>
        </joint>
      </ros2_control>

      

    </xacro:if>

    <xacro:unless value="${sim_gz}">
       <!-- Placeholder for the real Robotiq RS485 physical interface -->
       <!-- We will add the real driver plugin here later -->
    </xacro:unless>

  </xacro:macro>
</robot>