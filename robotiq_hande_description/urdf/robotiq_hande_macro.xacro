<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotiq_hande">

  <!-- Include finger macros -->
  <xacro:include filename="$(find robotiq_hande_description)/urdf/finger_aluminum.xacro" />
  <xacro:include filename="$(find robotiq_hande_description)/urdf/finger_v1.xacro" />

  <xacro:macro name="robotiq_hande_gripper" params="parent *origin sim_gazebo:=false finger_type:=aluminum">
  
    <!-- Gripper Base Joint connecting parent to gripper_body -->
    <joint name="gripper_base_joint" type="fixed">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/> 
      <child link="gripper_body"/>
    </joint>

    <!-- Gripper Body -->
    <link name="gripper_body">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/hand-e-body.stl"/>
        </geometry>
        <material name="gray"><color rgba="0.4 0.4 0.4 1.0"/></material>
      </visual>
      <!-- <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/hand-e-body.stl"/>
        </geometry>
      </collision> -->
      <collision>
        <origin xyz="0 0 ${0.099/2}" rpy="0 0 0"/>
        <geometry>
          <cylinder length="0.099" radius="${0.0375 + 0.001}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.86"/>
        <origin xyz="0 0 0.042" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
    </link>



    <!-- Left Fingerbase -->
    <link name="left_fingerbase">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/left_fingerbase.stl"/>
        </geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/left_fingerbase.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0.008 -0.008" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="finger_joint" type="prismatic">
      <parent link="gripper_body"/>
      <child link="left_fingerbase"/>
      <origin xyz="-0.01425 -0.022014 0.11430" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.003" upper="0.028" effort="130" velocity="0.15"/> 
    </joint>

    <!-- Right Fingerbase -->
    <link name="right_fingerbase">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/right_fingerbase.stl"/>
        </geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/right_fingerbase.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 -0.008 -0.008" rpy="0 0 0"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="finger2_joint" type="prismatic">
      <parent link="gripper_body"/>
      <child link="right_fingerbase"/>
      <origin xyz="0.01425 0.022014 0.11430" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-0.003" upper="0.028" effort="130" velocity="0.15"/> 
      <mimic joint="finger_joint" multiplier="1.0" offset="0.0"/>
    </joint>

    <!-- <gazebo>
      <plugin filename="gz-sim-mimic-joint-system" name="gz::sim::systems::MimicJoint">
        <joint>finger_joint</joint>
        <mimicJoint>finger2_joint</mimicJoint>
        <multiplier>1.0</multiplier>
      </plugin>
    </gazebo> -->

    <!-- Finger pair and TCP selection -->
    <xacro:if value="${finger_type in ['aluminum', 'aluminium']}">
      <xacro:finger_aluminum parent_left="left_fingerbase" parent_right="right_fingerbase" tcp_parent="gripper_body" />
    </xacro:if>
    <xacro:if value="${finger_type in ['v1', 'finger_v1', 'top_bottom_v1']}">
      <xacro:finger_v1 parent_left="left_fingerbase" parent_right="right_fingerbase" tcp_parent="gripper_body" />
    </xacro:if>

    <!-- Camera Mount -->
    <link name="camera_mount">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/camera_mount_95.stl"/>
        </geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/camera_mount_95.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
      </inertial>
    </link>

    <joint name="camera_mount_joint" type="fixed">
      <parent link="gripper_body"/>
      <child link="camera_mount"/>
      <origin xyz="-0.031 0 0.0898" rpy="0 ${-pi/2} 0"/>
    </joint>

    <!-- Camera -->
    <link name="camera_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/realsense_D405.stl"/>
        </geometry>
        <material name="black"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 ${pi/2} 0"/>
        <geometry>
          <mesh filename="package://robotiq_hande_description/meshes/realsense_D405.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.072"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.00005" ixy="0" ixz="0" iyy="0.00005" iyz="0" izz="0.00005"/>
      </inertial>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent link="camera_mount"/>
      <child link="camera_link"/>
      <origin xyz="0.01 0 0.023" rpy="0 ${5*pi/180} 0"/>
    </joint>

    <link name="camera_link_optical"/>

    <joint name="camera_optical_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="camera_link_optical"/>
      <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- RealSense driver root frame alias -->
    <link name="wrist_camera_link"/>
    <joint name="wrist_camera_joint" type="fixed">
      <parent link="camera_link"/>
      <child link="wrist_camera_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>